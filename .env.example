# Lead Automation Environment Variables
# ======================================
# Copy this file to .env and fill in your actual values

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Apollo.io API Key
APOLLO_API_KEY=your_apollo_api_key_here

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instantly.ai API Key (get from Instantly dashboard -> Settings -> API)
INSTANTLY_API_KEY=your_instantly_api_key_here

# Google Calendar ID for 10-minute callback events.
# Use the explicit calendar ID shared with sheets-access@lead-automation-484819.iam.gserviceaccount.com
CALLBACK_CALENDAR_ID=

# CRM cutover defaults. Change one dimension at a time only after the gates in
# docs/crm/MIGRATION.md pass. Boolean values must be exactly true or false.
CRM_DB_ENABLED=false
CRM_ACCOUNTS_READ_MODEL=legacy
CRM_PROPOSALS_READ_MODEL=legacy
CRM_COMMAND_WRITER=sheet
CRM_SHEETS_PROJECTION_ENABLED=false
CRM_AGENT_EVENTS_ENABLED=false

# Browser-compatible HTTP Basic identity for all protected CRM browser reads.
# All six values are required to enable access. Keep the password in a secret store.
# CRM_PRINCIPAL_IS_ADMIN accepts exactly true or false.
CRM_PRINCIPAL_USERNAME=
CRM_PRINCIPAL_PASSWORD=
CRM_PRINCIPAL_WORKSPACE_ID=
CRM_PRINCIPAL_ACTOR_ID=
CRM_PRINCIPAL_PERMISSIONS=crm:read
CRM_PRINCIPAL_IS_ADMIN=false

# Short-lived server-to-server principal for POST /api/v1/agent-events.
# Keep the bearer token in the server secret store; never expose it to browser code.
CRM_AGENT_BEARER_TOKEN=
CRM_AGENT_WORKSPACE_ID=
CRM_AGENT_SCOPES=agent-events:write
CRM_AGENT_SOURCE_SCOPES=
CRM_AGENT_TOKEN_ISSUED_AT=
CRM_AGENT_TOKEN_EXPIRES_AT=
