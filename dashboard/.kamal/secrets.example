# Kamal Secrets Template
# Copy this file to 'secrets' and fill in the values

# Docker Registry
KAMAL_REGISTRY_PASSWORD=your_docker_hub_token

# Dashboard Authentication
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your_secure_password_here

# CRM API protection (fake placeholders; replace during deployment)
CRM_WRITE_TOKEN=replace_with_random_write_token
CRM_CSRF_TOKEN=replace_with_random_csrf_token

# Protected CRM browser identity (fake placeholder; replace during deployment)
CRM_PRINCIPAL_PASSWORD=replace_with_random_principal_password

# PostgreSQL connection (fake placeholder; psycopg driver is required)
DATABASE_URL=postgresql+psycopg://crm_user:replace_with_database_password@database.example.invalid/crm
